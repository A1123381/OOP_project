<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.exambattle</groupId>
        <artifactId>exam-battle</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tools</artifactId>
    <name>Exam Battle - Tools (dev and test utilities)</name>

    <properties>
        <main.class>com.exambattle.tools.LoadTestMain</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.exambattle</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 測試時啟動真正的伺服器 -->
        <dependency>
            <groupId>com.exambattle</groupId>
            <artifactId>server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.exambattle</groupId>
            <artifactId>server</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 測試時只顯示 WARNING 以上的伺服器日誌 -->
                        <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
